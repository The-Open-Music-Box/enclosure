; layer_change_gcode = ;AFTER_LAYER_CHANGE\n;[layer_z]\n{if ! spiral_mode}M74 W[extruded_weight_total]{endif}\n\n; Timelapse : memoriser la position de reprise\n{local photo_x = position[0]}\n{local photo_y = position[1]}\n{local photo_z = position[2]}\n\n; Degager la buse puis aller au centre\nG90\nG1 Z{min(photo_z + 1, max_print_height)} F720\nG1 X125 Y105 F6000\nG4 S0\nG4 P500 ; Laisser le plateau se stabiliser\n\n; Mise au point puis photo\nM264 P1 B1 ; Maintenir le contact focus\nG4 P1000   ; Attendre 1 seconde pour la mise au point\nM264 P0 B1 ; Appuyer sur le declencheur\nG4 P200\nM264 P0 B0 ; Relacher le declencheur\nM264 P1 B0 ; Relacher le focus\nG4 P500   ; Attendre avant de repartir\n\n; Revenir avant de redescendre\nG1 X{photo_x} Y{photo_y} F6000\nG1 Z{photo_z} F720\n; Fin timelapse
