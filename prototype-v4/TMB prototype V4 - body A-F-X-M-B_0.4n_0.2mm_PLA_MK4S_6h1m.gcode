; EXECUTABLE_BLOCK_START
M486 S0
M486 ATMB_prototype_V4_-_body_id_0_copy_0
M486 S-1
M73 P0 R360
M201 X4000 Y4000 Z200 E2500
M203 X300 Y300 Z40 E100
M204 P4000 R2500 T4000 ; sets acceleration (P, T) and retract acceleration (R), mm/sec^2
M205 X8.00 Y8.00 Z2.00 E10.00 ; sets the jerk limits, mm/sec
;TYPE:Custom
M17 ; enable steppers
M862.1 P0.4 F0 ; nozzle check
M862.3 P "MK4S" ; printer model check
M862.5 P2 ; g-code level check
M862.6 P "Input shaper" ; FW feature check
M862.6 P "MMU3" ; FW feature check
M115 U6.5.7+12836

; setup MMU
M708 A0x0b X5   ; extra load distance
M708 A0x0d X140 ; unload feeedrate
M708 A0x11 X140 ; load feedrate
M708 A0x14 X50  ; slow feedrate
M708 A0x1e X12  ; Pulley current to ~200mA
M708 A0x12 X90  ; selector feedrate mm/s
M708 A0x13 X400 ; idler feedrate deg/s
M708 A0x0f X400 ; selector acceleration mm/s2

M555 X57.6783 Y41.8902 W172.521 H148.159

G90 ; use absolute coordinates
M83 ; extruder relative mode

M140 S65 ; set bed temp
M104 S170 ; set extruder temp for bed leveling
M109 R170 ; wait for temp

M84 E ; turn off E motor

G28 ; home all without mesh bed level

G1 X42 Y-4 Z5 F4800

M302 S155 ; lower cold extrusion limit to 155C


G1 E-2 F2400 ; retraction
M73 P1 R356


M84 E ; turn off E motor

G29 P9 X10 Y-4 W32 H4



G0 Z40 F10000

M190 S65 ; wait for bed temp

M107

;
; MBL
;
M84 E ; turn off E motor
G29 P1 ; invalidate mbl & probe print area
G29 P1 X0 Y0 W130 H20 C ; probe near purge place
G29 P3.2 ; interpolate mbl probes
G29 P3.13 ; extrapolate mbl outside probe area
G29 A ; activate mbl

; prepare for purge
M104 S230
G0 X0 Y-4 Z15 F4800 ; move away and ready for the purge
M109 S230

G92 E0
M569 S0 E ; set spreadcycle mode for extruder

T4
G1 E17 F1000 ; load to the nozzle

;
; Extrude purge line
;
G92 E0 ; reset extruder position
G1 E2 F2400 ; deretraction after the initial one before nozzle cleaning
G0 E7 X15 Z0.2 F500 ; purge
G0 X105 E36 F500 ; purge
G0 X115 E4 F650 ; purge
G0 X125 E4 F800 ; purge
G0 X128 Z0.05 F8000 ; wipe, move close to the bed
G0 X131 Z0.2 F8000 ; wipe, move quickly away from the bed

G92 E0
M221 S100 ; set flow to 100%

; Initialisation Hackerboard
M262 P0 B0 ; Sortie photo
M262 P1 B0 ; Sortie focus
M264 P0 B0 ; Relacher photo
M264 P1 B0 ; Relacher focus
G90
G21
M83 ; use relative distances for extrusion
T4
M900 K0.05 ; Filament gcode


M572 S0.036 ; Filament gcode


M142 S36 ; set heatbreak target temp
M900 K0.03; Override pressure advance value
G1 Z.2 F720
M106 S0
;LAYER_CHANGE
;Z:0.2
;HEIGHT:0.2
;BEFORE_LAYER_CHANGE
G92 E0.0
;0.2
M201 X4000 Y4000

;AFTER_LAYER_CHANGE
;0.2
M74 W0

; Timelapse : memoriser la position de reprise




; Degager la buse puis aller au centre
G90
G1 Z1.2 F720
G1 X125 Y105 F6000
G4 S0
G4 P500 ; Laisser le plateau se stabiliser

; Mise au point puis photo
M264 P1 B1 ; Maintenir le contact focus
G4 P1000   ; Attendre 1 seconde pour la mise au point
M264 P0 B1 ; Appuyer sur le declencheur
G4 P200
M264 P0 B0 ; Relacher le declencheur
M264 P1 B0 ; Relacher le focus
G4 P500   ; Attendre avant de repartir

; Revenir avant de redescendre
G1 X0 Y0
G1 Z0.2 F720
; Fin timelapse
